{
  "name": "maimara-pasteleria",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "sanity:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "sanity:seed-admin": "tsx --env-file=.env.local scripts/seed-admin.ts",
    "sanity:deploy": "sanity schema deploy",
    "sanity:studio": "sanity dev --config sanity.config.ts"
  },
  "dependencies": {
    "@sanity/client": "^7.6.0",
    "@sanity/image-url": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "next": "^15.3.3",
    "next-auth": "^5.0.0-beta.31",
    "next-sanity": "^9.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanity": "^3.93.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
